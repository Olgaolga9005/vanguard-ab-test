    <worksheet name='Number of Accounts'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Tableau Bold' fontsize='12'>Clients Distribution per Number of Accounts and Tenure</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='10'>- </run>
            <run bold='true' fontcolor='#000000' fontsize='10'>Over ~96% </run>
            <run fontcolor='#000000' fontsize='10'>of clients in both Control and Test groups hold</run>
            <run bold='true' fontcolor='#000000' fontsize='10'> 2–3 accounts</run>
            <run fontcolor='#000000' fontsize='10'>, with an average tenure of </run>
            <run bold='true' fontcolor='#000000' fontsize='10'>10–15 years</run>
            <run fontcolor='#000000' fontsize='10'>. </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='10'>- The remaining</run>
            <run bold='true' fontcolor='#000000' fontsize='10'> ~3–4% </run>
            <run fontcolor='#000000' fontsize='10'>of clients with higher numbers of accounts and longer tenure are considered negligible outliers.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='final_vanguard_dataset' name='federated.0cfyabf1c7pffs0zw1qfg0dhmek2' />
          </datasources>
          <datasource-dependencies datasource='federated.0cfyabf1c7pffs0zw1qfg0dhmek2'>
            <column-instance column='[clnt_tenure_yr]' derivation='Avg' name='[avg:clnt_tenure_yr:qk]' pivot='key' type='quantitative' />
            <column caption='Client ID' datatype='integer' name='[client_id]' role='measure' type='quantitative' />
            <column caption='Client Tenure (yr)' datatype='real' name='[clnt_tenure_yr]' role='measure' type='quantitative' />
            <column-instance column='[num_accts]' derivation='None' name='[none:num_accts:qk]' pivot='key' type='quantitative' />
            <column-instance column='[variation]' derivation='None' name='[none:variation:nk]' pivot='key' type='nominal' />
            <column caption='Num Accounts' datatype='real' name='[num_accts]' role='measure' type='quantitative' />
            <column-instance column='[client_id]' derivation='CountD' name='[pcto:ctd:client_id:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' type='PctTotal' />
            </column-instance>
            <column caption='Group' datatype='string' name='[variation]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;control&quot;' value='Control' />
                <alias key='&quot;test&quot;' value='Test' />
              </aliases>
            </column>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0cfyabf1c7pffs0zw1qfg0dhmek2].[Exclusions (Group,Num Accounts)]'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='crossjoin'>
                <groupfilter function='level-members' level='[none:variation:nk]' />
                <groupfilter function='level-members' level='[none:num_accts:qk]' />
              </groupfilter>
              <groupfilter function='reorder-dimensionality'>
                <groupfilter function='crossjoin'>
