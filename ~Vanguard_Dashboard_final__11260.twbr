    <worksheet name='H1: Completion Rate'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Tableau Bold' fontsize='12'>H1: Completion Rate</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#009600' fontsize='10'>+17.53% Relative Lift</run>
            <run>Æ&#10;</run>
            <run fontcolor='#54585a' fontsize='10'>Significant breakthrough in the core business objective.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#54585a' fontsize='10'>This exceeds the minimum threshold of 5% for cost effectiveness.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#1a1a1a' fontsize='10'><![CDATA[Statistically Significant (p < 0.001)]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='final_vanguard_dataset' name='federated.0cfyabf1c7pffs0zw1qfg0dhmek2' />
          </datasources>
          <datasource-dependencies datasource='federated.0cfyabf1c7pffs0zw1qfg0dhmek2'>
            <column caption='Completed Process' datatype='real' name='[Calculation_0773849131409410]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [completed] = TRUE THEN [visit_id] END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([visit_id])' />
            </column>
            <column caption='Completed' datatype='boolean' name='[completed]' role='dimension' type='nominal'>
              <aliases>
                <alias key='false' value='Not Completed' />
                <alias key='true' value='Completed' />
              </aliases>
            </column>
            <column-instance column='[variation]' derivation='None' name='[none:variation:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0773849131409410]' derivation='User' name='[usr:Calculation_0773849131409410:qk]' pivot='key' type='quantitative' />
            <column caption='Group' datatype='string' name='[variation]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;control&quot;' value='Control' />
                <alias key='&quot;test&quot;' value='Test' />
              </aliases>
            </column>
            <column caption='Visit ID' datatype='string' name='[visit_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.0cfyabf1c7pffs0zw1qfg0dhmek2].[usr:Calculation_0773849131409410:qk]' scope='rows' value='Completion Rate' />
