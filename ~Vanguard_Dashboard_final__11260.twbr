  <worksheets>
    <worksheet name='Average Tenure by Age Group'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Tableau Bold' fontsize='12'>Clients Tenure by Age Group</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontsize='10'>- A clear trend is observed, with progressively higher tenure in older Age Groups.</run>
          </formatted-text>
