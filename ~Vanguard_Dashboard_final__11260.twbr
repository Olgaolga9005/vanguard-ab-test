      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0cfyabf1c7pffs0zw1qfg0dhmek2].[ctd:client_id:qk]&quot;' value='Total Clients' />
          <alias key='&quot;[federated.0cfyabf1c7pffs0zw1qfg0dhmek2].[pcto:ctd:client_id:qk:3]&quot;' value='Clients (%)' />
        </aliases>
      </column>
      <column caption='Duration' datatype='real' name='[Calculation_0773848502661120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(step_duration_min)*5' />
      </column>
      <column caption='Session Duration (min)' datatype='real' name='[Calculation_0773848504623105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[session_duration_seconds]/60' />
      </column>
      <column caption='Completed Process' datatype='real' name='[Calculation_0773849131409410]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [completed] = TRUE THEN [visit_id] END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([visit_id])' />
      </column>
      <column caption='Error Rate' datatype='real' name='[Calculation_0773849133223939]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(INT([is_error])) / COUNT([step_num]))' />
      </column>
      <column caption='Call per client' datatype='real' name='[Calculation_0773849137565700]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#13;&#10;    { FIXED [client_id] : MAX([calls_6_mnth]) }&#13;&#10;)' />
      </column>
      <column caption='Session Duration per Client' datatype='real' name='[Calculation_0773849146032133]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [visit_id] : AVG([Calculation_0773848504623105]) }' />
      </column>
      <column caption='Num Acct per Client' datatype='real' name='[Calculation_0773849149558790]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({ FIXED [client_id] : SUM([num_accts]) })' />
      </column>
