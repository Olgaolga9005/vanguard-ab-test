      <aliases enabled='yes' />
      <column caption='completed_process' datatype='real' datatype-customized='true' default-format='p0.0%' name='[Calculation_1666376711434243]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [completed] = TRUE THEN [visit_id] END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([visit_id])' />
      </column>
      <column caption='session_duration_min' datatype='real' name='[Calculation_1666376940154884]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[session_duration_seconds]/60' />
      </column>
      <column caption='error_rate' datatype='real' name='[Calculation_1666377049206790]' role='measure' type='quantitative'>
